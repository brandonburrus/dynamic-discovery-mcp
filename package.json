{
  "name": "dynmcp",
  "version": "0.0.1",
  "description": "Dynamic MCP context management tool for AI MCP-enabled agents and clients.",
  "author": "Brandon Burrus <brandon@burrus.io>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/brandonburrus/dynamic-discovery-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "proxy",
    "dynamic",
    "discovery",
    "tools",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonburrus/dynamic-discovery-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/brandonburrus/dynamic-discovery-mcp/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dynmcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "generate:schema": "tsx scripts/generate-schema.ts",
    "prebuild": "tsx scripts/generate-schema.ts",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "enquirer": "^2.4.1",
    "fastmcp": "^4.0.1",
    "figlet": "^1.11.0",
    "figures": "^6.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
